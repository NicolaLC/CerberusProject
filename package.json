{
  "name": "cerberus-project",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:artifact": "node scripts/build-artifact.mjs",
    "test": "node tests/ballistics.test.mjs && node tests/levelio.test.mjs",
    "desktop": "vite build && electron .",
    "desktop:dist": "vite build && electron-builder"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "vite": "^7.3.7"
  },
  "description": "Cerberus — third-person sci-fi cover shooter",
  "main": "desktop/main.js",
  "build": {
    "appId": "dev.cerberus.game",
    "productName": "Cerberus",
    "copyright": "Proprietary, see LICENSE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/artifact/**",
      "desktop/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.action-games",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "executableName": "cerberus",
      "synopsis": "Third-person sci-fi cover shooter"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "deb": {
      "packageName": "cerberus"
    }
  },
  "author": {
    "name": "NicolaLC",
    "email": "3704156+NicolaLC@users.noreply.github.com"
  },
  "homepage": "https://github.com/NicolaLC/CerberusProject"
}
